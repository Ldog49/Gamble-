# Local Postgres. On Railway this is provided automatically via a variable
# reference to the Postgres plugin (${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pl_bet_tracker?schema=public"

# console.anthropic.com — used server-side to read bet slip photos
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# football-data.org — free API key, used to fetch Premier League fixtures/results
FOOTBALL_DATA_API_KEY=""
# The starting year of the PL season, e.g. 2025 for the 2025/26 season
FOOTBALL_DATA_SEASON="2025"

# Random string used to sign the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Shared secret that lets the scheduled GitHub Actions job trigger a results
# sync without a user session. Must match the SYNC_SECRET repo secret in
# GitHub (Settings > Secrets and variables > Actions). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SYNC_SECRET=""

# Where uploaded slip photos are written. On Railway this should be a path
# inside the mounted Volume, e.g. /data/slips
SLIP_STORAGE_PATH="./local-data/slips"
